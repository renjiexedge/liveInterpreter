/* App-wide stylesheet, loaded by ui/style.py:apply_stylesheet().
   Selectors: type (QPushButton) for defaults, #objectName for one-off widgets,
   [property="value"] for groups and states set via widget.setProperty().
   @name values are colour tokens from ui/theme.py (design.md §2), substituted
   on load. Severity colours stay literal. */

/* ---- Main window (ui/main_window.py, design.md §1) ----------------------
   Rules are scoped to #homeWindow / #interpreterWindow, so dialogs and message
   boxes keep the native Windows look. */
QMainWindow#homeWindow, #homeWindow QWidget {
    font-family: "Nunito Sans", "Segoe UI";
    font-size: 13px;
    color: @ink;
}
#homeCentral {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @surface, stop:1 @surface-tint);
}
#homeContent, #homeHeader QLabel {
    background: transparent;
}
QFrame#homeHeader {
    background: @surface;
    border-bottom: 1px solid @line;
}

/* Report a bug */
#homeHeader QPushButton[role="pill"] {
    background: @surface;
    border: 1px solid @line;
    border-radius: 16px;
    min-height: 30px;
    padding: 0 14px;
    font-weight: 700;
}
#homeHeader QPushButton[role="pill"]:hover   { border-color: @brand-orange; }
#homeHeader QPushButton[role="pill"]:pressed { background: @surface-tint; }
#homeHeader QPushButton[role="pill"]:focus   { border: 2px solid @brand-orange; }

/* Profile: avatar + name, no border */
QPushButton#profileButton {
    background: transparent;
    border: none;
    border-radius: 20px;
}
QPushButton#profileButton:hover, QPushButton#profileButton:pressed { background: @surface-tint; }
QPushButton#profileButton::menu-indicator { image: none; width: 0; }
#homeWindow QLabel#avatar {
    background: @brand-sky;
    border-radius: 16px;
    font-weight: 700;
    font-size: 12px;
}
#homeWindow QLabel[role="profileName"] { font-weight: 700; }
QMenu#profileMenu {
    background: @surface;
    border: 1px solid @line;
    padding: 4px;
}
QMenu#profileMenu::item { padding: 6px 20px; border-radius: 6px; color: @ink; }
QMenu#profileMenu::item:selected { background: @brand-sky; }

/* Feature buttons: TransGull-style pills */
#homeWindow QPushButton[role="feature"] {
    background: @surface;
    border: 1px solid @line;
    border-radius: 26px;
}
#homeWindow QPushButton[role="feature"]:hover   { border-color: @brand-orange; }
#homeWindow QPushButton[role="feature"]:pressed { background: @surface-tint; }
#homeWindow QPushButton[role="feature"]:focus   { border: 2px solid @brand-orange; }
#homeWindow QLabel[role="featureLabel"] {
    font-family: "Be Vietnam Pro", "Segoe UI";
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#homeWindow QLabel[role="openDot"] {
    color: @brand-aqua;
    font-size: 10px;
    background: transparent;
}

/* Feature not built yet: disabled, with a "Coming soon" tag */
#homeWindow QPushButton[role="feature"][state="soon"] { background: @surface-tint; }
#homeWindow QPushButton[state="soon"] QLabel[role="featureLabel"] { color: @ink-soft; }
#homeWindow QLabel[role="soonPill"] {
    background: @brand-aqua;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

/* ---- Live Interpreter window (ui/live_interpreter.py, design.md §6) ------ */
QMainWindow#interpreterWindow, #interpreterWindow QWidget {
    font-family: "Nunito Sans", "Segoe UI";
    font-size: 13px;
    color: @ink;
}
#interpreterWindow QWidget:disabled { color: @muted; }
#interpreterCentral { background: @surface-tint; }
QFrame#interpreterHeader {
    background: @surface;
    border-bottom: 1px solid @line;
}
#interpreterWindow QLabel[role="windowTitle"] {
    font-family: "Be Vietnam Pro", "Segoe UI";
    font-size: 18px;
    font-weight: 600;
}
#interpreterWindow QLabel[role="statusLine"] { font-weight: 700; }

/* Cards */
#interpreterWindow QFrame[role="card"] {
    background: @surface;
    border: 1px solid @line;
    border-radius: 12px;
}
#interpreterWindow QLabel[role="cardTitle"] {
    font-family: "Be Vietnam Pro", "Segoe UI";
    font-size: 15px;
    font-weight: 600;
}
#interpreterWindow QFrame[role="divider"] { background: @line; border: none; }
#interpreterWindow QLabel[role="directionTitle"],
#interpreterWindow QLabel[role="columnTitle"] { font-weight: 700; }
#interpreterWindow QLabel[role="directionStatus"] { color: @ink-soft; }

/* Buttons: secondary by default; one primary (Start) and one danger (Stop) */
#interpreterWindow QPushButton {
    background: @surface;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 7px 14px;
    font-weight: 700;
}
#interpreterWindow QPushButton:hover   { border-color: @ink-soft; }
#interpreterWindow QPushButton:pressed { background: @surface-tint; }
#interpreterWindow QPushButton:focus   { border: 2px solid @brand-orange; }
#interpreterWindow QPushButton:disabled {
    background: @surface-tint;
    border-color: @line;
    color: @muted;
}
#interpreterWindow QPushButton[variant="primary"] {
    background: @brand-orange;
    border-color: @brand-orange;
}
#interpreterWindow QPushButton[variant="primary"]:hover {
    background: @brand-orange-hover;
    border-color: @brand-orange-hover;
}
#interpreterWindow QPushButton[variant="primary"]:focus { border: 2px solid @ink; }
#interpreterWindow QPushButton[variant="danger"] {
    border-color: #c62828;
    color: #c62828;
}
#interpreterWindow QPushButton[variant="primary"]:disabled,
#interpreterWindow QPushButton[variant="danger"]:disabled {
    background: @surface-tint;
    border-color: @line;
    color: @muted;
}
/* Mute, while muted: shaded, so a muted direction is visible at a glance */
#interpreterWindow QPushButton[role="mute"]:checked {
    background: @brand-sky;
    border-color: @ink-soft;
}

/* Combos */
#interpreterWindow QComboBox {
    background: @surface;
    border: 1px solid @line;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 18px;
}
#interpreterWindow QComboBox:hover { border-color: @ink-soft; }
#interpreterWindow QComboBox:focus { border: 2px solid @brand-orange; }
#interpreterWindow QComboBox:disabled { background: @surface-tint; }
#interpreterWindow QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}
#interpreterWindow QComboBox::down-arrow { image: url(@assets/icons/chevron-down.svg); width: 12px; height: 12px; }
#interpreterWindow QComboBox::down-arrow:disabled { image: url(@assets/icons/chevron-down-disabled.svg); }
#interpreterWindow QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @line;
    outline: 0;
    selection-background-color: @brand-sky;
    selection-color: @ink;
}

/* Transcripts */
#interpreterWindow QScrollArea {
    background: @surface;
    border: 1px solid @line;
    border-radius: 8px;
}
#interpreterWindow QWidget#transcriptList { background: @surface; }
#interpreterWindow QLabel[role="transcriptPair"] {
    padding: 6px 4px;
    border-bottom: 1px solid @line;
}

/* WhatsApp "use the other end of the wire" hints under the device combos. */
QLabel[role="hint"] {
    /* font-style: italic; */
}
#interpreterWindow QLabel[role="hint"] {
    font-size: 12px;
    color: @ink-soft;
}

/* Audio health dot (ui/issue_panel.py StatusDot). */
QLabel#statusDot {
    font-size: 18px;
}
QLabel#statusDot[severity="ok"]      { color: #2e7d32; }
QLabel#statusDot[severity="warning"] { color: #f9a825; }
QLabel#statusDot[severity="problem"] { color: #c62828; }

/* One row per active Issue in the issue panel. */
QFrame#issueRow {
    padding-left: 6px;
    background: @surface;
    border: 1px solid @line;
    border-radius: 8px;
}
QFrame#issueRow[severity="ok"]      { border-left: 4px solid #2e7d32; }
QFrame#issueRow[severity="warning"] { border-left: 4px solid #f9a825; }
QFrame#issueRow[severity="problem"] { border-left: 4px solid #c62828; }

QLabel[role="issueMessage"] {
    font-weight: bold;
}
